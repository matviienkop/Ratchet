#!/usr/bin/python3 -I
"""Broker power, test and package-install verbs against operator-pinned QEMU guests."""
import base64
import json
from pathlib import Path
import re
import subprocess
import sys
import time


class Lab:
    def __init__(self, cfg, vmid):
        self.cfg = cfg
        self.identity = cfg["guests"][vmid]
        self.prefix = cfg["api"] + "/api2/json/nodes/" + cfg["node"] + "/qemu/" + vmid + "/"

    def api(self, resource, data=None):
        args = ["/usr/bin/curl", "-q", "--silent", "--show-error", "--fail-with-body", "--noproxy", "*",
                "--connect-timeout", "5", "--max-time", "25", "--cacert", self.cfg["ca"], "--resolve",
                self.cfg["resolve"], "--header", "@" + self.cfg["authorization"]]
        if data is not None:
            args.extend(["--header", "Content-Type: application/json", "--data-binary", "@-"])
        body = json.dumps(data).encode() if data is not None else b""
        response = subprocess.run([*args, self.prefix + resource], input=body, capture_output=True,
                                  env={"LANG": "C", "PATH": "/usr/bin:/bin"})
        if response.returncode:
            raise ValueError(response.stderr.decode(errors="replace").strip() + " " +
                             response.stdout.decode(errors="replace").strip())
        return json.loads(response.stdout)["data"]

    def verify(self):
        config = self.api("config?current=1")
        smbios = dict(item.split("=", 1) for item in config["smbios1"].split(",") if "=" in item)
        if config["name"] != self.identity["name"] or smbios.get("uuid") != self.identity["uuid"]:
            raise ValueError("Registered guest name or UUID differs from the live VM.")

    def status(self):
        return self.api("status/current")["status"]

    def power(self, action):
        if action == "status":
            print(self.status())
            return
        wanted = "running" if action == "start" else "stopped"
        if self.status() != wanted:
            self.api("status/" + action, {})
            deadline = time.monotonic() + 180
            while self.status() != wanted:
                if time.monotonic() >= deadline:
                    raise ValueError("Guest did not reach " + wanted)
                time.sleep(2)
        print(wanted)

    def test(self, argv):
        if self.status() != "running":
            raise ValueError("Guest is stopped. Start it before testing.")
        # Encode argv to preserve literal values through systemd's ExecStart expansion.
        encoded = base64.b64encode(json.dumps(argv).encode()).decode()
        name = self.cfg["guest_user"]
        state = self.cfg["state_directory"]
        work = "/var/lib/" + state
        launch = ("import base64,json,os,sys\n"
                  "if os.getuid() == 0 or os.getgid() == 0 or set(os.getgroups()) - {os.getgid()}:\n"
                  "    sys.exit('Guest test identity has unexpected privileges.')\n"
                  "argv=json.loads(base64.b64decode(sys.argv[1]))\n"
                  "os.execvp(argv[0],argv)")
        command = [
            "/usr/bin/systemd-run", "--quiet", "--wait", "--pipe", "--collect", "--service-type=exec",
            "--uid=" + name, "--property=StateDirectory=" + state,
            "--property=StateDirectoryMode=0700", "--property=WorkingDirectory=" + work,
            "--setenv=HOME=" + work, "--property=NoNewPrivileges=yes", "--property=CapabilityBoundingSet=",
            "--property=PrivateDevices=yes", "--property=ProtectHome=yes", "--property=ProtectSystem=strict",
            "--property=PrivateTmp=yes", "--property=RestrictNamespaces=yes", "--property=RestrictSUIDSGID=yes",
            "--property=ProtectKernelTunables=yes", "--property=ProtectKernelModules=yes",
            "--property=ProtectControlGroups=yes", "--property=IPAddressDeny=any",
            "--property=IPAddressAllow=localhost", "--property=RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6",
            "--property=RuntimeMaxSec=900", "--property=TasksMax=256", "--", "/usr/bin/python3", "-I", "-c",
            launch, encoded,
        ]
        return self.execute(command)

    def install(self, url, digest):
        """Install one release package as root. The registered prefix bounds where it may come from."""
        rules = self.cfg.get("install", {})
        prefix = rules.get("url_prefix", "")
        # Some packages refuse replacement outside their own maintenance command; the operator names it here.
        replace = rules.get("replace_with", [])
        if not isinstance(replace, list) or not all(isinstance(part, str) and part for part in replace):
            raise ValueError("install.replace_with must be a list of command words.")
        if (not prefix.startswith("https://") or not url.startswith(prefix) or ".." in url
                or not re.fullmatch(r"https://[A-Za-z0-9._~/%+-]+\.deb", url)):
            raise ValueError("Package URL is outside the registered release location.")
        if not re.fullmatch(r"[0-9a-f]{64}", digest):
            raise ValueError("Pass the package SHA-256 as 64 lowercase hex digits.")
        if self.status() != "running":
            raise ValueError("Guest is stopped. Start it before installing.")
        fetch = ("import hashlib,json,os,subprocess,sys,tempfile,urllib.request\n"
                 "url,digest,replace=sys.argv[1],sys.argv[2],json.loads(sys.argv[3])\n"
                 "env={'PATH':'/usr/sbin:/usr/bin:/sbin:/bin','DEBIAN_FRONTEND':'noninteractive','LANG':'C'}\n"
                 "with tempfile.TemporaryDirectory(prefix='ai-dev-install.',dir='/var/tmp') as folder:\n"
                 "    os.chmod(folder,0o755)\n"
                 "    path=os.path.join(folder,'package.deb')\n"
                 "    seen=hashlib.sha256()\n"
                 "    with urllib.request.urlopen(url,timeout=60) as source, open(path,'wb') as target:\n"
                 "        if not source.geturl().startswith('https://'):\n"
                 "            sys.exit('Package download left HTTPS.')\n"
                 "        while chunk:=source.read(1<<20):\n"
                 "            seen.update(chunk)\n"
                 "            target.write(chunk)\n"
                 "            if target.tell()>1<<30:\n"
                 "                sys.exit('Package exceeds one gibibyte.')\n"
                 "    if seen.hexdigest()!=digest:\n"
                 "        sys.exit('Package digest differs from the expected SHA-256.')\n"
                 "    name=subprocess.run(['dpkg-deb','--field',path,'Package'],check=True,capture_output=True,"
                 "text=True,env=env).stdout.strip()\n"
                 "    present=subprocess.run(['dpkg-query','--show','--showformat','${db:Status-Status}',name],"
                 "capture_output=True,text=True,env=env).stdout.strip()=='installed'\n"
                 "    subprocess.run(['dpkg','--configure','-a'],check=True,env=env,stdin=subprocess.DEVNULL)\n"
                 "    command=['apt-get','install','--yes','--quiet','--no-install-recommends',path]\n"
                 "    subprocess.run((replace if present else [])+command,check=True,env=env,"
                 "stdin=subprocess.DEVNULL)\n"
                 "    subprocess.run(['dpkg-query','--show','--showformat',"
                 "'installed ${Package} ${Version} ${db:Status-Status}\\n',name],check=True,env=env)\n")
        return self.execute(["/usr/bin/python3", "-I", "-c", fetch, url, digest, json.dumps(replace)])

    def execute(self, command):
        deadline = time.monotonic() + 180
        while True:
            try:
                pid = int(self.api("agent/exec", {"command": command})["pid"])
                break
            except ValueError as error:
                if "guest agent is not running" not in str(error).lower() or time.monotonic() >= deadline:
                    raise
                time.sleep(2)
        deadline = time.monotonic() + 930
        while True:
            result = self.api("agent/exec-status?pid=" + str(pid))
            if result["exited"]:
                for key, stream in (("out", sys.stdout), ("err", sys.stderr)):
                    stream.write(result.get(key + "-data", ""))
                    if result.get(key + "-truncated"):
                        print("Guest " + key + "put was truncated.", file=sys.stderr)
                return result.get("exitcode", 128 + result.get("signal", 1))
            if time.monotonic() >= deadline:
                raise ValueError("Guest command exceeded its execution deadline.")
            time.sleep(1)


VERBS = ("start", "shutdown", "status", "test", "install")


def main(args):
    usage = (f"Usage: {Path(sys.argv[0]).name} VMID status|start|shutdown | test [--] COMMAND [ARG...] | "
             "install [--] PACKAGE_URL SHA256")
    if len(args) < 2:
        raise ValueError(usage)
    vmid, action, *argv = args
    if action in ("test", "install") and argv[:1] == ["--"]:
        argv = argv[1:]
    expected = len(argv) == 2 if action == "install" else (action == "test") == bool(argv)
    if action not in VERBS or not expected:
        raise ValueError(usage)
    cfg = json.loads(Path(__file__ + ".json").read_text())
    if vmid not in cfg["guests"]:
        raise ValueError("Guest ID is outside the configured lab.")
    lab = Lab(cfg, vmid)
    allowed = lab.identity.get("operations", ["start", "shutdown", "status", "test"])
    if not isinstance(allowed, list) or action not in allowed or any(verb not in VERBS for verb in allowed):
        raise ValueError("Operation is outside this guest's grant.")
    lab.verify()
    if action == "test":
        return lab.test(argv)
    if action == "install":
        return lab.install(*argv)
    lab.power(action)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except (OSError, KeyError, ValueError) as exc:
        sys.exit("Lab failed: " + str(exc))
