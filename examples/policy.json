{
  "defaults": {
    "check_timeout": 900,
    "max_attempts": 5,
    "max_defect_failures": 5,
    "review": {"max_rounds": 5, "reviewer": "reviewer"}
  },
  "repos": {
    "git@github.com:example/backend.git": {
      "project": "example",
      "target_branch": "origin/main",
      "delivery": "pr",
      "pr_ci": {"repository": "example/backend", "branch": "main", "ci_workflow": "build.yml"},
      "checks": [
        {"name": "unit", "argv": ["make", "test"]},
        {"name": "lint", "argv": ["make", "lint"], "timeout": 300},
        {"name": "stand", "argv": ["make", "check", "check-race"], "stage": "post_review", "stand": "ubuntu-amd64", "timeout": 3600}
      ]
    }
  }
}
